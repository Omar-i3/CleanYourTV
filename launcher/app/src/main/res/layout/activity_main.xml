<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/bg_night">

    <!-- Scenic Wallpaper: Stunning AlUla Landscape -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_alula"
        android:importantForAccessibility="no" />

    <!-- Dark cinematic UrTV scrim overlay for maximum legibility of widgets and apps -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_overlay"
        android:importantForAccessibility="no" />

    <!-- Time-of-day backdrop -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Focused dock app's name, anchored on the LEFT above the dock -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|start"
        android:layout_marginLeft="56dp"
        android:layout_marginStart="56dp"
        android:alpha="0"
        android:textColor="@color/sand"
        android:textSize="44sp"
        android:fontFamily="@font/thmanyah_medium"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Header row: Quick Pills on Left, Arabic Clock & Greeting on Right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Left: UrTV Quick Action Pills -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnScreensaver"
                    style="@style/TopButton"
                    android:text="شاشة التوقف"
                    android:drawableStart="@drawable/ic_picture"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnCustomization"
                    style="@style/TopButton"
                    android:text="تخصيص الواجهة"
                    android:drawableStart="@drawable/ic_tune"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="إعدادات النظام"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>

            <!-- Top Right: Islamic Greeting, UrTV Gold Divider, Clock & Date -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="right|end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|end"
                    android:gravity="right|end"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="مساء الخير"
                    android:textColor="@color/sand"
                    android:textSize="17sp"
                    android:fontFamily="@font/thmanyah_bold"
                    android:letterSpacing="0.02" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right|bottom|end"
                    android:layout_gravity="right|end"
                    android:baselineAligned="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="right|end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="right|end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="@color/sand"
                            android:textSize="14sp"
                            android:fontFamily="@font/thmanyah_regular"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="right|end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:format12Hour="EEEE d MMMM"
                            android:format24Hour="EEEE d MMMM"
                            android:textColor="@color/dim"
                            android:textSize="14sp"
                            android:fontFamily="@font/thmanyah_medium" />
                    </LinearLayout>

                    <!-- UrTV gold vertical rule separator -->
                    <View
                        android:layout_width="1.5dp"
                        android:layout_height="26dp"
                        android:layout_marginLeft="14dp"
                        android:layout_marginRight="14dp"
                        android:layout_gravity="center_vertical"
                        android:background="#4DDCB86F" />

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/thmanyah_bold"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right|end"
                    android:textColor="@color/dim"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Middle Zone: UrTV Glassmorphic Prayer & Hadith Dashboard -->
        <LinearLayout
            android:id="@+id/islamicDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Card 1: Hadith of the Day (UrTV Panel Style) -->
            <LinearLayout
                android:id="@+id/cardHadith"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_glass_card"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layoutDirection="rtl"
                android:nextFocusDown="@+id/grid"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/hadithBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حديث اليوم"
                        android:textColor="@color/gold_hi"
                        android:textSize="12sp"
                        android:fontFamily="@font/thmanyah_bold"
                        android:background="@drawable/badge_hadith_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <!-- UrTV Signature Golden Divider Line -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/gold_divider_line" />

                    <TextView
                        android:id="@+id/hadithCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فضل الصلاة"
                        android:textColor="@color/dim"
                        android:textSize="12sp"
                        android:fontFamily="@font/thmanyah_medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hadithText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="@color/sand"
                    android:textSize="14sp"
                    android:fontFamily="@font/thmanyah_regular" />

                <TextView
                    android:id="@+id/hadithSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end"
                    android:textColor="@color/dim"
                    android:textSize="12sp"
                    android:fontFamily="@font/thmanyah_regular" />
            </LinearLayout>

            <!-- Card 2: UrTV Prayer & Iqamah Times (Preserving Iqamah with UrTV Aesthetics) -->
            <LinearLayout
                android:id="@+id/cardPrayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_glass_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layoutDirection="rtl"
                android:nextFocusDown="@+id/grid"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/prayerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مواقيت الصلاة والإقامة"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:fontFamily="@font/thmanyah_bold"
                        android:letterSpacing="0.04" />

                    <!-- UrTV Signature Golden Divider Line -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/gold_divider_line" />

                    <TextView
                        android:id="@+id/prayerCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="العصر بعد --"
                        android:textColor="@color/gold_hi"
                        android:textSize="12sp"
                        android:fontFamily="@font/thmanyah_medium" />
                </LinearLayout>

                <!-- UrTV 5 Prayers Grid Row (.prow with Iqamah Pills) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="5">

                    <!-- Fajr -->
                    <LinearLayout
                        android:id="@+id/slotFajr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="2.5dp"
                        android:background="@drawable/prayer_normal_bg"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/nameFajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="@color/dim" android:textSize="12sp" android:fontFamily="@font/thmanyah_medium" />
                        <TextView android:id="@+id/azanFajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="05:12" android:textColor="@color/sand" android:textSize="14sp" android:fontFamily="@font/thmanyah_bold" />
                        <TextView android:id="@+id/iqamaFajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/badge_iqamah_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:text="05:37" android:textColor="@color/gold" android:textSize="10sp" android:fontFamily="@font/thmanyah_medium" />
                    </LinearLayout>

                    <!-- Dhuhr -->
                    <LinearLayout
                        android:id="@+id/slotDhuhr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="2.5dp"
                        android:background="@drawable/prayer_normal_bg"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/nameDhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="@color/dim" android:textSize="12sp" android:fontFamily="@font/thmanyah_medium" />
                        <TextView android:id="@+id/azanDhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="12:05" android:textColor="@color/sand" android:textSize="14sp" android:fontFamily="@font/thmanyah_bold" />
                        <TextView android:id="@+id/iqamaDhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/badge_iqamah_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:text="12:25" android:textColor="@color/gold" android:textSize="10sp" android:fontFamily="@font/thmanyah_medium" />
                    </LinearLayout>

                    <!-- Asr -->
                    <LinearLayout
                        android:id="@+id/slotAsr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="2.5dp"
                        android:background="@drawable/prayer_normal_bg"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/nameAsr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="@color/dim" android:textSize="12sp" android:fontFamily="@font/thmanyah_medium" />
                        <TextView android:id="@+id/azanAsr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="15:26" android:textColor="@color/sand" android:textSize="14sp" android:fontFamily="@font/thmanyah_bold" />
                        <TextView android:id="@+id/iqamaAsr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/badge_iqamah_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:text="15:46" android:textColor="@color/gold" android:textSize="10sp" android:fontFamily="@font/thmanyah_medium" />
                    </LinearLayout>

                    <!-- Maghrib -->
                    <LinearLayout
                        android:id="@+id/slotMaghrib"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="2.5dp"
                        android:background="@drawable/prayer_normal_bg"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/nameMaghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="@color/dim" android:textSize="12sp" android:fontFamily="@font/thmanyah_medium" />
                        <TextView android:id="@+id/azanMaghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="17:51" android:textColor="@color/sand" android:textSize="14sp" android:fontFamily="@font/thmanyah_bold" />
                        <TextView android:id="@+id/iqamaMaghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/badge_iqamah_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:text="18:01" android:textColor="@color/gold" android:textSize="10sp" android:fontFamily="@font/thmanyah_medium" />
                    </LinearLayout>

                    <!-- Isha -->
                    <LinearLayout
                        android:id="@+id/slotIsha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="2.5dp"
                        android:background="@drawable/prayer_normal_bg"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/nameIsha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="@color/dim" android:textSize="12sp" android:fontFamily="@font/thmanyah_medium" />
                        <TextView android:id="@+id/azanIsha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="19:21" android:textColor="@color/sand" android:textSize="14sp" android:fontFamily="@font/thmanyah_bold" />
                        <TextView android:id="@+id/iqamaIsha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/badge_iqamah_bg" android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="1.5dp" android:paddingBottom="1.5dp" android:text="19:41" android:textColor="@color/gold" android:textSize="10sp" android:fontFamily="@font/thmanyah_medium" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Smart Folders / Categories Bar -->
        <LinearLayout
            android:id="@+id/categoryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/catAll"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:text="الكل"
                android:nextFocusDown="@+id/grid" />

            <TextView
                android:id="@+id/catStreaming"
                style="@style/TopButton"
                android:text="سينما وبث"
                android:nextFocusDown="@+id/grid" />

            <TextView
                android:id="@+id/catSports"
                style="@style/TopButton"
                android:text="رياضة"
                android:nextFocusDown="@+id/grid" />

            <TextView
                android:id="@+id/catGames"
                style="@style/TopButton"
                android:text="ألعاب"
                android:nextFocusDown="@+id/grid" />

            <TextView
                android:id="@+id/catTools"
                style="@style/TopButton"
                android:text="أدوات"
                android:nextFocusDown="@+id/grid" />
        </LinearLayout>

        <!-- Apps Grid Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- GlassView disabled -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
