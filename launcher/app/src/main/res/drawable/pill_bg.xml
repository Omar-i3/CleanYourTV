<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F6EFE0" />
            <corners android:radius="21dp" />
            <stroke android:width="2dp" android:color="#DCB86F" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#D6AF6B"
                android:endColor="#DCB86F" />
            <stroke android:width="1.8dp" android:color="#FFE9B8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#40DCB86F" />
            <stroke android:width="1.5dp" android:color="#DCB86F" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26DCB86F"
                android:endColor="#14040E09" />
            <stroke android:width="1dp" android:color="#33DCB86F" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
