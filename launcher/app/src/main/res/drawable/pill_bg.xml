<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F8FAFC" />
            <corners android:radius="21dp" />
            <stroke android:width="2dp" android:color="#38BDF8" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0284C7"
                android:endColor="#0066FF" />
            <stroke android:width="1.8dp" android:color="#38BDF8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
