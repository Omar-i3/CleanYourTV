<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#DCB86F"
                android:endColor="#D6AF6B" />
            <corners android:radius="12dp" />
            <stroke android:width="2.5dp" android:color="#FFE9B8" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#4DDCB86F"
                android:endColor="#33040E09" />
            <corners android:radius="12dp" />
            <stroke android:width="1.8dp" android:color="#DCB86F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9040E09" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#33DCB86F" />
        </shape>
    </item>
</selector>
