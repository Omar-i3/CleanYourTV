<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: UrTV Royal Gold stroke + soft glow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DDCB86F" />
            <stroke android:width="2.5dp" android:color="#FFE9B8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Normal state: subtle dark glass with fine gold rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4D040E09" />
            <stroke android:width="1dp" android:color="#24DCB86F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
