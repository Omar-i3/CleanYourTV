<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Apple TV / Google TV style bright white border + soft glow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Normal state: clean translucent card with subtle rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E121E32" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
