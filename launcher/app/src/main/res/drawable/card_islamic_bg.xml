<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F207120C"
                android:endColor="#FA0D1A12" />
            <stroke
                android:width="2dp"
                android:color="#DCB86F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B8040E09"
                android:endColor="#CC07140D" />
            <stroke
                android:width="1dp"
                android:color="#38DCB86F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
