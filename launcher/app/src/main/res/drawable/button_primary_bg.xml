<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#2563EB" android:endColor="#1D4ED8" android:angle="45" />
            <corners android:radius="14dp" />
            <stroke android:width="2.5dp" android:color="#93C5FD" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E3A8A" android:endColor="#172554" android:angle="45" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3B82F6" />
        </shape>
    </item>
</selector>
